generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ক্যাটাগরি মডেল
model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// প্রোডাক্ট মডেল
model Product {
  id            String      @id @default(uuid())
  name          String
  slug          String      @unique
  brand         String
  price         Float
  originalPrice Float?
  discount      String?
  shade         String?
  size          String?
  image         String
  reviewsCount  Int         @default(0)
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// অর্ডার মডেল (ভবিষ্যতে চেকআউটের জন্য)
model Order {
  id          String      @id @default(uuid())
  totalAmount Float
  status      String      @default("PENDING") // PENDING, COMPLETED, CANCELLED
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// অর্ডার আইটেম মডেল
model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}